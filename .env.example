# ==============================================================================
# ResQ — Environment Variables Template
# Copy this file to .env before starting Docker Compose:
# cp .env.example .env
# ==============================================================================

# Node Environment
NODE_ENV=development

# PostgreSQL + PostGIS Configuration
POSTGRES_USER=resq_user
POSTGRES_PASSWORD=resq_dev_password
POSTGRES_DB=resq_db
POSTGRES_PORT=5432
DATABASE_URL=postgres://resq_user:resq_dev_password@postgres:5432/resq_db

# RabbitMQ Message Broker Configuration
RABBITMQ_USER=resq_rabbit
RABBITMQ_PASS=resq_rabbit_dev_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://resq_rabbit:resq_rabbit_dev_password@rabbitmq:5672

# JWT Authentication
JWT_SECRET=resq_jwt_dev_secret_key_change_in_production_32char_min
JWT_EXPIRES_IN=24h

# Microservice Port Configurations
GATEWAY_PORT=8000
AUTH_PORT=8001
REPORT_PORT=8002
ORG_PORT=8003
MATCHING_PORT=8004
NOTIFICATION_PORT=8005
TRACKING_PORT=8006

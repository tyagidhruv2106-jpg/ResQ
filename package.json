{
  "name": "resq-backend",
  "version": "1.0.0",
  "description": "ResQ — Emergency Animal Distress & Rescue Coordination Backend",
  "main": "services/api-gateway/src/index.js",
  "scripts": {
    "start": "node scripts/start_all_services.js",
    "start:gateway": "node services/api-gateway/src/index.js",
    "start:auth": "node services/auth-service/src/index.js",
    "start:reports": "node services/report-service/src/index.js",
    "start:organizations": "node services/organization-service/src/index.js",
    "start:notifications": "node services/notification-service/src/index.js",
    "frontend": "npm run dev --prefix frontend",
    "seed": "node database/seed.js",
    "test:pipeline": "node scripts/verify_pipeline.js"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "http-proxy-middleware": "^3.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.12.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
